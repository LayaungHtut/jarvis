# Copy this file to .env and fill in your values.
# JARVIS never requires secrets to run — everything is optional.

# ---- JARVIS backend ----------------------------------------------------------
# Port/host the JARVIS agent WebSocket + REST server listens on.
JARVIS_PORT=8765
JARVIS_HOST=127.0.0.1
# Directory JARVIS stores memory.db, logs, screenshots, task files.
JARVIS_DATA_DIR=data
# Filesystem tool sandbox root. Defaults to the repo root.
JARVIS_WORKSPACE=
# Permission auto-approval policy, e.g. low:true,medium:true,high:false,critical:false
JARVIS_PERMISSIONS=

# ---- LLM providers -----------------------------------------------------------
# OpenRouter API key (https://openrouter.ai). When absent JARVIS falls back to
# the local provider. Accounts 2-4 are extra keys for billing/rate-limit spread.
OPENROUTER_API_KEY=
OPENROUTER_API_KEY_2=
OPENROUTER_API_KEY_3=
OPENROUTER_API_KEY_4=
# Local OpenAI-compatible endpoint (Ollama / LM Studio / llama.cpp server).
LOCAL_LLM_URL=http://127.0.0.1:11434
LOCAL_LLM_MODEL=qwen2.5:7b

# ---- Model routing (openrouter | local) --------------------------------------
# Fill in the model you want per category; leave blank to use defaults.
# JARVIS_MODEL_CONVERSATION=
# JARVIS_MODEL_PLANNING=
# JARVIS_MODEL_REASONING=
# JARVIS_MODEL_CODING=
# JARVIS_MODEL_VISION=
# JARVIS_MODEL_SUMMARIZATION=
# JARVIS_MODEL_EXTRACTION=
# JARVIS_MODEL_<CATEGORY>_PROVIDER=openrouter

# Model chain roles (planner → executor → critic → optimizer). Each role maps
# to an OpenRouter ACCOUNT (1..4) whose key is OPENROUTER_API_KEY/_2/_3/_4.
# JARVIS_CHAIN_PLANNER_MODEL=
# JARVIS_CHAIN_PLANNER_ACCOUNT=1
# JARVIS_CHAIN_EXECUTOR_MODEL=
# JARVIS_CHAIN_EXECUTOR_ACCOUNT=2
# JARVIS_CHAIN_CRITIC_MODEL=
# JARVIS_CHAIN_CRITIC_ACCOUNT=3
# JARVIS_CHAIN_OPTIMIZER_MODEL=
# JARVIS_CHAIN_OPTIMIZER_ACCOUNT=4
# JARVIS_CHAIN_<ROLE>_PROVIDER=openrouter

# ---- Memory stores (optional) ------------------------------------------------
# Cloud stores are registered as supabase-1/2 and neon-1/2. Unset stores are
# skipped and `local` (JARVIS_DATA_DIR/memory.db) is always used as fallback.
# SUPABASE_URL_1=
# SUPABASE_SERVICE_ROLE_KEY_1=
# SUPABASE_URL_2=
# SUPABASE_SERVICE_ROLE_KEY_2=
# NEON_DATABASE_URL_1=
# NEON_DATABASE_URL_2=
# SUPABASE_ACCOUNT_COUNT=
# NEON_ACCOUNT_COUNT=
# Route categories to stores, e.g. identity:supabase-1,work:supabase-2
# JARVIS_MEMORY_ROUTES=

# ---- Voice (optional) ----------------------------------------------------------
# Wake word for hands-free activation.
JARVIS_WAKE_WORD=jarvis
# STT provider: none | whisper-cli | openai. "none" disables mic transcription.
JARVIS_STT_PROVIDER=none
# TTS provider: windows | openai (optional).
JARVIS_TTS_PROVIDER=windows
# OpenAI API key, required when JARVIS_STT_PROVIDER=openai (Whisper API).
# OPENAI_API_KEY=
# Path to a whisper binary, required when JARVIS_STT_PROVIDER=whisper-cli.
# WHISPER_BIN=whisper