{
	"name": "jarvis",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:all": "concurrently -k -n agent,ui -c cyan,green \"npm:server:watch\" \"npm:dev\"",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:server": "svelte-kit sync && tsc -p tsconfig.server.json",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"server": "tsx server/index.ts",
		"server:watch": "tsx watch server/index.ts",
		"migrate:memory": "tsx server/memory/migrate.ts",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.60.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^24",
		"@types/pg": "^8.21.0",
		"@types/ws": "^8.18.0",
		"@vitest/browser-playwright": "^4.1.8",
		"concurrently": "^9.2.0",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.20.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1",
		"ws": "^8.21.3"
	},
	"dependencies": {
		"@neondatabase/serverless": "^1.1.0",
		"@supabase/supabase-js": "^2.112.2",
		"js-yaml": "^5.2.3",
		"pg": "^8.23.0",
		"rolldown": "^1.2.3"
	}
}
